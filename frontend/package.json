{
  "name": "step-ca-webui-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The step-ca-webui single-page application. The generated client package is deliberately absent from dependencies: it is installed with `npm install --no-save` after `npm ci` (D8).",
  "license": "SEE LICENSE IN ../LICENSE",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check:sdk-surface": "node scripts/sdk-surface.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.3",
    "@tanstack/react-query": "5.106.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "eslint": {
      "minimatch": "^11.0.1"
    }
  }
}
